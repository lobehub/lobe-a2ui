{
  "name": "@lobehub/a2ui",
  "version": "1.4.0",
  "description": "A2UI surfaces drawn with @lobehub/ui: the official A2UI basic catalog plus LobeHub's extensions, schema validation, the A2UI prompt, text fallback and the React renderer",
  "keywords": [
    "a2ui",
    "agent-ui",
    "generative-ui",
    "lobehub",
    "react"
  ],
  "homepage": "https://github.com/lobehub/lobe-a2ui",
  "bugs": {
    "url": "https://github.com/lobehub/lobe-a2ui/issues/new"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lobehub/lobe-a2ui.git"
  },
  "license": "MIT",
  "author": "LobeHub <i@lobehub.com>",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./es/index.d.mts",
      "import": "./es/index.mjs",
      "default": "./es/index.mjs"
    },
    "./react": {
      "types": "./es/react/index.d.mts",
      "import": "./es/react/index.mjs",
      "default": "./es/react/index.mjs"
    },
    "./*": {
      "types": "./es/*.d.mts",
      "import": "./es/*.mjs",
      "default": "./es/*.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "es/index.mjs",
  "module": "es/index.mjs",
  "types": "es/index.d.mts",
  "files": [
    "es"
  ],
  "scripts": {
    "build": "tsdown",
    "ci": "npm run lint && npm run type-check",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "lint:circular": "dpdm src/**/*.{ts,tsx} --warning false --tree false --exit-code circular:1 -T true",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "prettier": "prettier -c --write --no-error-on-unmatched-pattern \"**/**\"",
    "release": "semantic-release",
    "test": "vitest --run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "type-check": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{md,mdx}": [
      "prettier --write --no-error-on-unmatched-pattern"
    ],
    "*.json": [
      "prettier --write --no-error-on-unmatched-pattern"
    ],
    "*.{js,jsx}": [
      "prettier --write",
      "stylelint --fix",
      "eslint --fix"
    ],
    "*.{ts,tsx}": [
      "prettier --parser=typescript --write",
      "stylelint --fix",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@a2ui/react": "0.16.1",
    "@a2ui/web_core": "0.16.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@lobehub/charts": "^6.3.0",
    "@lobehub/lint": "^2.1.6",
    "@lobehub/ui": "^6.26.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "~1.2.2",
    "commitlint": "^19.8.1",
    "dpdm": "^3.15.1",
    "eslint": "^10.12.0",
    "happy-dom": "^20.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "lucide-react": "^1.80.0",
    "maplibre-gl": "^5.24.1",
    "motion": "^14.14.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark": "^15.0.1",
    "remark-cli": "^12.0.1",
    "semantic-release": "^21.1.2",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.3",
    "vitest": "~1.2.2"
  },
  "peerDependencies": {
    "@lobehub/charts": "^6.3.0",
    "@lobehub/ui": "^6.26.0",
    "lucide-react": "^1.55.0",
    "maplibre-gl": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
