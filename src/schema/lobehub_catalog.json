{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lobehub.com/a2ui/catalog/lobehub.json",
  "protocolVersion": "1.0",
  "title": "LobeHub A2UI Extensions",
  "description": "LobeHub's components on top of the A2UI basic catalog: headed cards, icon sets, metrics, charts, tables, key facts, progress, steps and grids, drawn with @lobehub/ui and @lobehub/charts. Card and Icon here extend the basic definitions.",
  "catalogId": "https://lobehub.com/a2ui/catalog/v1",
  "components": {
    "Card": {
      "type": "object",
      "properties": {
        "component": {
          "const": "Card"
        },
        "child": {
          "$ref": "common_types.json#/$defs/Child",
          "description": "The ID of the single child component to be rendered inside the card. To display multiple elements, you MUST wrap them in a layout component (like Column or Row) and pass that container's ID here. Do NOT pass multiple IDs or a non-existent ID."
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        },
        "title": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Card heading. Lead with the conclusion, e.g. 'Pro is the better fit'."
        },
        "description": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "One line under the title."
        },
        "badge": {
          "$ref": "common_types.json#/$defs/Child",
          "description": "ID of a component shown at the header end, usually a Tag."
        }
      },
      "required": [
        "component",
        "child"
      ],
      "description": "The outer card of a surface, or a group inside one: a bordered container with an optional header. Its header (title, description and a badge such as a Tag) is drawn by the product's card heading, so use it instead of assembling a heading from Text."
    },
    "Icon": {
      "type": "object",
      "properties": {
        "component": {
          "const": "Icon"
        },
        "name": {
          "description": "The name of the icon to display.",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "accountCircle",
                "add",
                "arrowBack",
                "arrowForward",
                "attachFile",
                "calendarToday",
                "call",
                "camera",
                "check",
                "close",
                "delete",
                "download",
                "edit",
                "event",
                "error",
                "fastForward",
                "favorite",
                "favoriteOff",
                "folder",
                "help",
                "home",
                "info",
                "locationOn",
                "lock",
                "lockOpen",
                "mail",
                "menu",
                "moreVert",
                "moreHoriz",
                "notificationsOff",
                "notifications",
                "pause",
                "payment",
                "person",
                "phone",
                "photo",
                "play",
                "print",
                "refresh",
                "rewind",
                "search",
                "send",
                "settings",
                "share",
                "shoppingCart",
                "skipNext",
                "skipPrevious",
                "star",
                "starHalf",
                "starOff",
                "stop",
                "upload",
                "visibility",
                "visibilityOff",
                "volumeDown",
                "volumeMute",
                "volumeOff",
                "volumeUp",
                "warning"
              ]
            },
            {
              "type": "object",
              "properties": {
                "svgPath": {
                  "$ref": "common_types.json#/$defs/DynamicString"
                }
              },
              "required": [
                "svgPath"
              ],
              "additionalProperties": false
            },
            {
              "$ref": "common_types.json#/$defs/DataBinding"
            },
            {
              "type": "string",
              "description": "An icon name in `set`."
            }
          ]
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        },
        "set": {
          "type": "string",
          "enum": [
            "lucide",
            "simple",
            "lobehub"
          ],
          "description": "The icon set `name` belongs to. Omit for the basic names."
        },
        "size": {
          "type": "number",
          "minimum": 10,
          "maximum": 64,
          "description": "Size in px. Default 20."
        },
        "color": {
          "type": "string",
          "enum": [
            "default",
            "secondary",
            "primary",
            "success",
            "warning",
            "error",
            "brand"
          ],
          "description": "Icon colour; 'brand' uses the brand's own colour (simple and lobehub sets). Default inherits the text colour."
        },
        "variant": {
          "type": "string",
          "enum": [
            "mono",
            "color",
            "avatar"
          ],
          "description": "For the lobehub set: mono glyph (default), colour glyph, or a filled avatar."
        }
      },
      "required": [
        "component",
        "name"
      ],
      "description": "An icon. Without `set`, `name` is one of the basic names below (or an svgPath). With `set`, `name` names an icon in that set: 'lucide' takes a Lucide name in kebab-case (e.g. 'trending-up', 'calendar-clock'); 'simple' takes a Simple Icons brand slug (e.g. 'github', 'notion', 'slack'); 'lobehub' takes an AI model or provider id from LobeHub Icons (e.g. 'OpenAI', 'Claude', 'DeepSeek'). Unknown names are rejected."
    },
    "Tag": {
      "type": "object",
      "description": "A short status label, e.g. as a Card badge.",
      "properties": {
        "component": {
          "const": "Tag"
        },
        "text": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Short label."
        },
        "color": {
          "type": "string",
          "enum": [
            "default",
            "success",
            "warning",
            "error",
            "info"
          ],
          "description": "Default 'default'."
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "component",
        "text"
      ]
    },
    "Metrics": {
      "type": "object",
      "description": "Headline figures side by side (MetricStrip). They share one row while readable and wrap into balanced rows when not. Not a table.",
      "properties": {
        "component": {
          "const": "Metrics"
        },
        "items": {
          "description": "Peer figures, 1–8.",
          "oneOf": [
            {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string",
                    "description": "The figure as a short string: '667', '1.01s', '¥440'."
                  },
                  "delta": {
                    "type": "string",
                    "description": "The change: '+62%', '424 → 667'."
                  },
                  "direction": {
                    "type": "string",
                    "enum": [
                      "up",
                      "down",
                      "flat"
                    ]
                  },
                  "tone": {
                    "type": "string",
                    "enum": [
                      "good",
                      "bad",
                      "warn",
                      "neutral"
                    ],
                    "description": "Whether this is good or bad news; colours the figure."
                  },
                  "hint": {
                    "type": "string",
                    "description": "One short line of context."
                  }
                },
                "required": [
                  "label",
                  "value"
                ],
                "additionalProperties": false
              }
            },
            {
              "$ref": "common_types.json#/$defs/DataBinding"
            }
          ]
        },
        "variant": {
          "type": "string",
          "enum": [
            "joined",
            "split"
          ],
          "description": "joined: one strip (default); split: separate tiles."
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "component",
        "items"
      ]
    },
    "Callout": {
      "type": "object",
      "description": "Something to notice: a verdict, an incident, a blocker, a confirmation.",
      "properties": {
        "component": {
          "const": "Callout"
        },
        "level": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "info",
            "success"
          ]
        },
        "title": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "One line."
        },
        "body": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Markdown detail."
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "component",
        "level",
        "title"
      ]
    },
    "Items": {
      "type": "object",
      "description": "A titled list of things that each carry a status: follow-ups, issues, a checklist.",
      "properties": {
        "component": {
          "const": "Items"
        },
        "title": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "items": {
          "description": "At most 30.",
          "oneOf": [
            {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "new",
                      "worse",
                      "human",
                      "blocked",
                      "watch",
                      "done"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "description": "Markdown, one line."
                  },
                  "detail": {
                    "type": "string"
                  }
                },
                "required": [
                  "title"
                ],
                "additionalProperties": false
              }
            },
            {
              "$ref": "common_types.json#/$defs/DataBinding"
            }
          ]
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "component",
        "title",
        "items"
      ]
    },
    "Bars": {
      "type": "object",
      "description": "A short series as bars where single points need marking. Prefer Chart otherwise.",
      "properties": {
        "component": {
          "const": "Bars"
        },
        "title": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "values": {
          "description": "Numbers.",
          "oneOf": [
            {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "number"
              }
            },
            {
              "$ref": "common_types.json#/$defs/DataBinding"
            }
          ]
        },
        "labels": {
          "oneOf": [
            {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "string"
              }
            },
            {
              "$ref": "common_types.json#/$defs/DataBinding"
            }
          ],
          "description": "Axis labels, evenly spread."
        },
        "marks": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "bad",
              "warn",
              "good"
            ]
          },
          "description": "{ \"<index>\": tone } marks chosen bars."
        },
        "caption": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "unit": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "component",
        "title",
        "values"
      ]
    },
    "Chart": {
      "type": "object",
      "description": "A chart drawn with @lobehub/charts.",
      "properties": {
        "component": {
          "const": "Chart"
        },
        "type": {
          "type": "string",
          "enum": [
            "line",
            "area",
            "bar",
            "donut",
            "barList",
            "scatter",
            "funnel",
            "radar",
            "heatmap",
            "tracker",
            "sparkLine",
            "sparkArea",
            "sparkBar",
            "categoryBar"
          ],
          "description": "line/area: a trend over time. bar: compare groups. donut: share of a whole (first category). barList: a ranking. scatter: x/y relation (categories = [x, y, size?], index = series). funnel: stage drop-off. radar: several attributes per series. heatmap: daily activity (index = date YYYY-MM-DD, first category = count). tracker: one block per period coloured by its `tone` field (good|bad|warn|neutral), index = tooltip. sparkLine/sparkArea/sparkBar: a tiny inline trend. categoryBar: one bar split into segments."
        },
        "data": {
          "description": "Rows of plain values, at most 200.",
          "oneOf": [
            {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "object"
              }
            },
            {
              "$ref": "common_types.json#/$defs/DataBinding"
            }
          ]
        },
        "index": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Row field on the axis, or the slice / stage / block name."
        },
        "categories": {
          "$ref": "common_types.json#/$defs/DynamicStringList",
          "description": "Numeric row fields to draw, at most 4 series."
        },
        "title": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "unit": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Appended to every value, e.g. 'ms'."
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "component",
        "type",
        "data",
        "index"
      ]
    },
    "Table": {
      "type": "object",
      "description": "Rows and columns read across and down: a comparison of options, a schedule, a price list.",
      "properties": {
        "component": {
          "const": "Table"
        },
        "title": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "caption": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "columns": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "align": {
                "type": "string",
                "enum": [
                  "start",
                  "center",
                  "end"
                ]
              }
            },
            "required": [
              "key",
              "label"
            ],
            "additionalProperties": false
          },
          "description": "At most 8. Right-align ('end') numbers."
        },
        "rows": {
          "description": "Rows keyed by column key; cells are short strings or numbers. At most 50.",
          "oneOf": [
            {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            },
            {
              "$ref": "common_types.json#/$defs/DataBinding"
            }
          ]
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "component",
        "columns",
        "rows"
      ]
    },
    "KeyValue": {
      "type": "object",
      "description": "Facts about one thing as label / value pairs: a profile, a spec, an order, settings.",
      "properties": {
        "component": {
          "const": "KeyValue"
        },
        "title": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "description": "Pairs per row (default 2)."
        },
        "items": {
          "description": "At most 30.",
          "oneOf": [
            {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string",
                    "description": "Markdown, one line."
                  }
                },
                "required": [
                  "label",
                  "value"
                ],
                "additionalProperties": false
              }
            },
            {
              "$ref": "common_types.json#/$defs/DataBinding"
            }
          ]
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "component",
        "items"
      ]
    },
    "Progress": {
      "type": "object",
      "description": "How far along something is: a quota, a goal, a rollout.",
      "properties": {
        "component": {
          "const": "Progress"
        },
        "label": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "value": {
          "$ref": "common_types.json#/$defs/DynamicNumber"
        },
        "max": {
          "$ref": "common_types.json#/$defs/DynamicNumber",
          "description": "Default 100."
        },
        "caption": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "e.g. '7.2 / 10 GB'; defaults to the percentage."
        },
        "tone": {
          "type": "string",
          "enum": [
            "good",
            "bad",
            "warn",
            "neutral"
          ],
          "description": "Whether this is good or bad news; colours the figure."
        },
        "variant": {
          "type": "string",
          "enum": [
            "line",
            "circle"
          ],
          "description": "line (default) or a small ring."
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "component",
        "label",
        "value"
      ]
    },
    "Steps": {
      "type": "object",
      "description": "Ordered stages: a plan, an itinerary, a process, a timeline of events.",
      "properties": {
        "component": {
          "const": "Steps"
        },
        "title": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "orientation": {
          "type": "string",
          "enum": [
            "vertical",
            "horizontal"
          ],
          "description": "vertical (default); horizontal for at most 5 short stages."
        },
        "items": {
          "description": "At most 20.",
          "oneOf": [
            {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "detail": {
                    "type": "string"
                  },
                  "meta": {
                    "type": "string",
                    "description": "A time, date or owner."
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "done",
                      "current",
                      "todo",
                      "error"
                    ]
                  }
                },
                "required": [
                  "title"
                ],
                "additionalProperties": false
              }
            },
            {
              "$ref": "common_types.json#/$defs/DataBinding"
            }
          ]
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "component",
        "items"
      ]
    },
    "Grid": {
      "type": "object",
      "description": "Children in equal columns, e.g. two options side by side or a set of small cards.",
      "properties": {
        "component": {
          "const": "Grid"
        },
        "children": {
          "$ref": "common_types.json#/$defs/ChildList"
        },
        "columns": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4,
          "description": "Columns, 2–4 (default 2). They stack when the card is narrow."
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "component",
        "children"
      ]
    }
  },
  "$defs": {
    "Weight": {
      "type": "number",
      "description": "The relative weight of this component within a Row or Column. This is similar to the CSS 'flex-grow' property. Note: this may ONLY be set when the component is a direct descendant of a Row or Column."
    }
  }
}