{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lobehub.com/a2ui/catalog/lobehub.json",
  "protocolVersion": "1.0",
  "title": "LobeHub A2UI Extensions",
  "description": "LobeHub's extensions on top of the A2UI basic catalog: neutral building blocks drawn with @lobehub/ui and @lobehub/charts. Every word shown comes from the Agent; props only set data, tone, size and layout. Icon names also reach a bundled set of Lucide icons.",
  "catalogId": "https://lobehub.com/a2ui/catalog/v1",
  "components": {
    "Card": {
      "type": "object",
      "description": "A card around one child. Inside another card it draws as a filled tile. With an action the whole card is clickable: give one that stands for a single thing with its own page (a PR, an order, a doc) an openUrl to that page.",
      "properties": {
        "component": {
          "const": "Card"
        },
        "child": {
          "$ref": "common_types.json#/$defs/Child",
          "description": "The ID of the single child component to be rendered inside the card. To display multiple elements, you MUST wrap them in a layout component (like Column or Row) and pass that container's ID here. Do NOT pass multiple IDs or a non-existent ID."
        },
        "action": {
          "$ref": "common_types.json#/$defs/Action",
          "description": "Optional. Runs when the card is clicked or activated from the keyboard: usually {\"functionCall\": {\"call\": \"openUrl\", \"args\": {\"url\": \"https://…\"}}}. Don't also put a Button for the same action inside."
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": ["component", "child"]
    },
    "Icon": {
      "type": "object",
      "description": "A small muted line icon by a basic name, or a Lucide icon as 'lucide:<name>' (e.g. 'lucide:rocket'). An accent beside a heading or label, never the content itself; no brand logos.",
      "properties": {
        "component": {
          "const": "Icon"
        },
        "name": {
          "description": "The name of the icon to display: a basic name, 'lucide:<name>', or an svgPath.",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "accountCircle",
                "add",
                "arrowBack",
                "arrowForward",
                "attachFile",
                "calendarToday",
                "call",
                "camera",
                "check",
                "close",
                "delete",
                "download",
                "edit",
                "event",
                "error",
                "fastForward",
                "favorite",
                "favoriteOff",
                "folder",
                "help",
                "home",
                "info",
                "locationOn",
                "lock",
                "lockOpen",
                "mail",
                "menu",
                "moreVert",
                "moreHoriz",
                "notificationsOff",
                "notifications",
                "pause",
                "payment",
                "person",
                "phone",
                "photo",
                "play",
                "print",
                "refresh",
                "rewind",
                "search",
                "send",
                "settings",
                "share",
                "shoppingCart",
                "skipNext",
                "skipPrevious",
                "star",
                "starHalf",
                "starOff",
                "stop",
                "upload",
                "visibility",
                "visibilityOff",
                "volumeDown",
                "volumeMute",
                "volumeOff",
                "volumeUp",
                "warning"
              ]
            },
            {
              "type": "string",
              "pattern": "^lucide:[A-Za-z0-9][A-Za-z0-9._-]*$",
              "description": "A Lucide icon, written 'lucide:<name>'. Only these names are bundled; others are rejected: activity alarm-clock archive arrow-down arrow-down-right arrow-left arrow-right arrow-up arrow-up-right award badge-check ban battery bell bell-off book book-open bookmark bot box brain briefcase bug building building-2 cake calculator calendar calendar-check calendar-days camera car chart-area chart-bar chart-column chart-line chart-pie check check-check chevron-right circle circle-alert circle-check circle-dot circle-help circle-pause circle-play circle-user-round circle-x clipboard-list clock cloud cloud-rain cloud-sun code coffee coins compass copy cpu credit-card crown database dollar-sign download droplet ellipsis ellipsis-vertical eye eye-off fast-forward file file-text film filter fingerprint-pattern flag flame flask-conical folder gauge gift git-branch git-commit-horizontal git-merge git-pull-request git-pull-request-arrow globe graduation-cap hammer hand-heart hard-drive hash headphones heart heart-off heart-pulse history hourglass house image inbox info key keyboard languages laptop layers layout-dashboard leaf lightbulb link list list-checks list-todo loader lock lock-open log-in mail map map-pin medal megaphone menu message-circle message-square mic monitor moon mountain music newspaper package palette paperclip pause pencil percent phone phone-call piggy-bank pin plane play plug plus printer puzzle receipt refresh-cw repeat rewind rocket rss save scale school search send server settings share-2 shield shield-alert shield-check shopping-bag shopping-cart skip-back skip-forward smartphone smile sparkles square star star-half star-off store sun tag target terminal thermometer thumbs-down thumbs-up ticket timer trash-2 tree-pine trending-down trending-up triangle-alert trophy truck tv umbrella upload user-round users utensils video volume-1 volume-2 volume-off volume-x wallet wand-sparkles wifi wind workflow wrench x zap"
            },
            {
              "type": "object",
              "properties": {
                "svgPath": {
                  "$ref": "common_types.json#/$defs/DynamicString"
                }
              },
              "required": ["svgPath"],
              "additionalProperties": false
            },
            {
              "$ref": "common_types.json#/$defs/DataBinding"
            }
          ]
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": ["component", "name"]
    },
    "Metrics": {
      "type": "object",
      "description": "Headline figures side by side (MetricStrip). They share one row while readable and wrap into balanced rows when not. Not a table.",
      "properties": {
        "component": {
          "const": "Metrics"
        },
        "items": {
          "description": "Peer figures, 1–8.",
          "oneOf": [
            {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string",
                    "description": "The figure as a short string: '667', '1.01s', '¥440'."
                  },
                  "delta": {
                    "type": "string",
                    "description": "The change: '+62%', '424 → 667'."
                  },
                  "direction": {
                    "type": "string",
                    "enum": ["up", "down", "flat"]
                  },
                  "tone": {
                    "type": "string",
                    "enum": ["good", "bad", "warn", "neutral"],
                    "description": "Whether this is good or bad news; colours the figure."
                  },
                  "hint": {
                    "type": "string",
                    "description": "One short line of context."
                  }
                },
                "required": ["label", "value"],
                "additionalProperties": false
              }
            },
            {
              "$ref": "common_types.json#/$defs/DataBinding"
            }
          ]
        },
        "variant": {
          "type": "string",
          "enum": ["joined", "split"],
          "description": "joined: one strip (default); split: separate tiles."
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": ["component", "items"]
    },
    "Chart": {
      "type": "object",
      "description": "A chart drawn with @lobehub/charts.",
      "properties": {
        "component": {
          "const": "Chart"
        },
        "type": {
          "type": "string",
          "enum": [
            "line",
            "area",
            "bar",
            "donut",
            "barList",
            "scatter",
            "funnel",
            "radar",
            "heatmap",
            "tracker",
            "sparkLine",
            "sparkArea",
            "sparkBar",
            "categoryBar"
          ],
          "description": "line/area: a trend over time. bar: compare groups. donut: share of a whole (first category). barList: a ranking. scatter: x/y relation (categories = [x, y, size?], index = series). funnel: stage drop-off. radar: several attributes per series. heatmap: daily activity (index = date YYYY-MM-DD, first category = count). tracker: one block per period coloured by its `tone` field (good|bad|warn|neutral), index = tooltip. sparkLine/sparkArea/sparkBar: a tiny inline trend. categoryBar: one bar split into segments."
        },
        "data": {
          "description": "Rows of plain values, at most 200.",
          "oneOf": [
            {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "object"
              }
            },
            {
              "$ref": "common_types.json#/$defs/DataBinding"
            }
          ]
        },
        "index": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Row field on the axis, or the slice / stage / block name."
        },
        "categories": {
          "$ref": "common_types.json#/$defs/DynamicStringList",
          "description": "Numeric row fields to draw, at most 4 series."
        },
        "title": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "unit": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Appended to every value, e.g. 'ms'."
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": ["component", "type", "data", "index"]
    },
    "Statistic": {
      "type": "object",
      "description": "One prominent figure with its label.",
      "properties": {
        "component": {
          "const": "Statistic"
        },
        "label": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "What the figure is."
        },
        "value": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "The figure, e.g. '4,812' or '1.8s'."
        },
        "prefix": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Text before the value, e.g. '$'."
        },
        "suffix": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Text after the value, e.g. 'ms'."
        },
        "caption": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "One line under the value."
        },
        "tone": {
          "type": "string",
          "enum": ["default", "success", "warning", "error"],
          "description": "Colours the value."
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": ["component", "label", "value"]
    },
    "Table": {
      "type": "object",
      "description": "Rows and columns read across and down: a comparison of options, a schedule, a price list.",
      "properties": {
        "component": {
          "const": "Table"
        },
        "title": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "caption": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "columns": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "align": {
                "type": "string",
                "enum": ["start", "center", "end"]
              }
            },
            "required": ["key", "label"],
            "additionalProperties": false
          },
          "description": "At most 8. Right-align ('end') numbers."
        },
        "rows": {
          "description": "Rows keyed by column key; cells are short strings or numbers. At most 50.",
          "oneOf": [
            {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "object",
                "additionalProperties": {
                  "type": ["string", "number", "boolean", "null"]
                }
              }
            },
            {
              "$ref": "common_types.json#/$defs/DataBinding"
            }
          ]
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": ["component", "columns", "rows"]
    },
    "KeyValue": {
      "type": "object",
      "description": "Facts about one thing as label / value pairs: a profile, a spec, an order, settings.",
      "properties": {
        "component": {
          "const": "KeyValue"
        },
        "title": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "description": "Pairs per row (default 2)."
        },
        "items": {
          "description": "At most 30.",
          "oneOf": [
            {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string",
                    "description": "Markdown, one line."
                  }
                },
                "required": ["label", "value"],
                "additionalProperties": false
              }
            },
            {
              "$ref": "common_types.json#/$defs/DataBinding"
            }
          ]
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": ["component", "items"]
    },
    "Progress": {
      "type": "object",
      "description": "How far along something is: a quota, a goal, a rollout.",
      "properties": {
        "component": {
          "const": "Progress"
        },
        "label": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "value": {
          "$ref": "common_types.json#/$defs/DynamicNumber"
        },
        "max": {
          "$ref": "common_types.json#/$defs/DynamicNumber",
          "description": "Default 100."
        },
        "caption": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "e.g. '7.2 / 10 GB'; defaults to the percentage."
        },
        "tone": {
          "type": "string",
          "enum": ["default", "success", "warning", "error", "info"],
          "description": "Bar colour."
        },
        "variant": {
          "type": "string",
          "enum": ["line", "circle"],
          "description": "line (default) or a small ring."
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": ["component", "label", "value"]
    },
    "Steps": {
      "type": "object",
      "description": "Ordered stages with a state each, drawn as a vertical or horizontal stepper.",
      "properties": {
        "component": {
          "const": "Steps"
        },
        "title": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "orientation": {
          "type": "string",
          "enum": ["vertical", "horizontal"],
          "description": "vertical (default); horizontal for at most 5 short stages."
        },
        "items": {
          "description": "At most 20.",
          "oneOf": [
            {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "detail": {
                    "type": "string"
                  },
                  "meta": {
                    "type": "string",
                    "description": "A time, date or owner."
                  },
                  "status": {
                    "type": "string",
                    "enum": ["done", "current", "todo", "error"],
                    "description": "The stage's state; drawn as a marker, never as words."
                  }
                },
                "required": ["title"],
                "additionalProperties": false
              }
            },
            {
              "$ref": "common_types.json#/$defs/DataBinding"
            }
          ]
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": ["component", "items"]
    },
    "Tag": {
      "type": "object",
      "description": "A short label with a semantic colour.",
      "properties": {
        "component": {
          "const": "Tag"
        },
        "text": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "The label."
        },
        "color": {
          "type": "string",
          "enum": ["default", "success", "warning", "error", "info"],
          "description": "Semantic colour. Default 'default'."
        },
        "icon": {
          "type": "string",
          "description": "Optional Icon name shown before the text (a basic name or 'lucide:<name>')."
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": ["component", "text"]
    },
    "Callout": {
      "type": "object",
      "description": "A highlighted message with a semantic level.",
      "properties": {
        "component": {
          "const": "Callout"
        },
        "level": {
          "type": "string",
          "enum": ["info", "success", "warning", "error"],
          "description": "Semantic level; sets colour and icon."
        },
        "title": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "One line."
        },
        "body": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Markdown detail."
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": ["component", "level", "title"]
    },
    "Avatar": {
      "type": "object",
      "description": "A person's, team's or thing's picture, emoji or initials.",
      "properties": {
        "component": {
          "const": "Avatar"
        },
        "src": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "https image URL."
        },
        "text": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "An emoji or a name's initials, when there is no image."
        },
        "size": {
          "type": "number",
          "minimum": 16,
          "maximum": 96,
          "description": "Size in px. Default 32."
        },
        "shape": {
          "type": "string",
          "enum": ["circle", "square"],
          "description": "Default 'circle'."
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": ["component"]
    },
    "Code": {
      "type": "object",
      "description": "A block of code with syntax highlighting and a copy button.",
      "properties": {
        "component": {
          "const": "Code"
        },
        "code": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "The code."
        },
        "language": {
          "type": "string",
          "description": "Language for highlighting, e.g. 'ts', 'python', 'bash', 'json'."
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": ["component", "code"]
    },
    "Collapse": {
      "type": "object",
      "description": "A section whose content opens from its header.",
      "properties": {
        "component": {
          "const": "Collapse"
        },
        "title": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "The header shown while collapsed."
        },
        "child": {
          "$ref": "common_types.json#/$defs/Child",
          "description": "The ID of the content shown when expanded."
        },
        "defaultOpen": {
          "type": "boolean",
          "description": "Start expanded. Default false."
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": ["component", "title", "child"]
    },
    "Grid": {
      "type": "object",
      "description": "Children in equal columns, e.g. two options side by side or a set of small cards.",
      "properties": {
        "component": {
          "const": "Grid"
        },
        "children": {
          "$ref": "common_types.json#/$defs/ChildList"
        },
        "columns": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4,
          "description": "Columns, 2–4 (default 2). They stack when the card is narrow."
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": ["component", "children"]
    }
  },
  "$defs": {
    "Weight": {
      "type": "number",
      "description": "The relative weight of this component within a Row or Column. This is similar to the CSS 'flex-grow' property. Note: this may ONLY be set when the component is a direct descendant of a Row or Column."
    }
  }
}
