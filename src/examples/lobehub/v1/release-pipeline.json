{
  "name": "Release Pipeline",
  "description": "Progress over time: a horizontal Steps for the stages, a tracker Chart for daily build health and a heatmap Chart for commit activity.",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "release-pipeline",
        "catalogId": "https://lobehub.com/a2ui/catalog/v1"
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "release-pipeline",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": ["title", "stages", "health", "activity"]
          },
          {
            "id": "title",
            "component": "Text",
            "text": "#### v2.4 release"
          },
          {
            "id": "stages",
            "component": "Steps",
            "orientation": "horizontal",
            "items": [
              {
                "title": "Freeze",
                "status": "done"
              },
              {
                "title": "QA",
                "status": "done"
              },
              {
                "title": "Canary",
                "status": "current"
              },
              {
                "title": "GA",
                "status": "todo"
              }
            ]
          },
          {
            "id": "health",
            "component": "Chart",
            "type": "tracker",
            "title": "Build health, last 14 days",
            "data": {
              "@path": "/builds"
            },
            "index": "day",
            "categories": ["tone"]
          },
          {
            "id": "activity",
            "component": "Chart",
            "type": "heatmap",
            "title": "Commits",
            "data": {
              "@path": "/commits"
            },
            "index": "date",
            "categories": ["count"]
          }
        ]
      }
    },
