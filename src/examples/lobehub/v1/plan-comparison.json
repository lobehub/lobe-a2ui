{
  "name": "Plan Comparison",
  "description": "Options compared: a Heading, a ComparisonTable with the recommended plan highlighted, and a Callout with the one thing to watch.",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "plan-comparison",
        "catalogId": "https://lobehub.com/a2ui/catalog/v1"
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "plan-comparison",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": ["head", "matrix", "watch"]
          },
          {
            "id": "head",
            "component": "Heading",
            "text": "Pro fits a 14-person team best",
            "eyebrow": "Compare plans",
            "subtitle": "All 14 seats and a year of storage headroom for $19 a seat"
          },
          {
            "id": "matrix",
            "component": "ComparisonTable",
            "options": ["Basic", "Pro", "Team"],
            "highlight": 1,
            "rows": [
              {
                "feature": "Price per seat",
                "values": ["$9", "$19", "$79"]
              },
              {
                "feature": "Seats",
                "values": [
                  3,
                  20,
                  100
                ]
              },
              {
                "feature": "Storage",
                "values": ["50 GB", "1 TB", "5 TB"]
              },
              {
                "feature": "SSO and SAML",
                "values": [
                  false,
                  false,
                  true
                ]
              },
              {
                "feature": "Audit log",
                "values": [
                  false,
                  true,
                  true
                ]
              }
            ]
          },
          {
            "id": "watch",
            "component": "Callout",
            "title": "Watch out",
            "text": "SSO is only on Team. Revisit at 20 seats.",
            "icon": "lucide:shield-alert"
          }
        ]
      }
    }
  ]
}
