{
  "name": "Model Comparison",
  "description": "Models compared: a Heading, a RadarChart of strengths per criterion, and a Caption marking the scores as an example.",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "model-comparison",
        "catalogId": "https://lobehub.com/a2ui/catalog/v1"
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "model-comparison",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": ["head", "strengths", "note"]
          },
          {
            "id": "head",
            "component": "Heading",
            "text": "Which model for support replies?",
            "subtitle": "Model B answers more accurately; Model A is cheaper and faster"
          },
          {
            "id": "strengths",
            "component": "RadarChart",
            "title": "Strengths, 1 to 10",
            "max": 10,
            "data": {
              "@path": "/strengths"
            }
          },
          {
            "id": "note",
            "component": "Caption",
            "text": "Scores are an example from an internal eval set."
          }
        ]
      }
    },
    {
      "version": "1.0",
      "updateDataModel": {
        "surfaceId": "model-comparison",
        "path": "/",
        "value": {
          "strengths": [
            {
              "axis": "Accuracy",
              "value": 7,
              "series": "Model A"
            },
            {
              "axis": "Speed",
              "value": 9,
              "series": "Model A"
            },
            {
              "axis": "Cost",
              "value": 8,
              "series": "Model A"
            },
            {
              "axis": "Tone",
              "value": 6,
              "series": "Model A"
            },
            {
              "axis": "Coding",
              "value": 8,
              "series": "Model A"
            },
            {
              "axis": "Accuracy",
              "value": 9,
              "series": "Model B"
            },
            {
              "axis": "Speed",
              "value": 7,
              "series": "Model B"
            },
            {
              "axis": "Cost",
              "value": 6,
              "series": "Model B"
            },
            {
              "axis": "Tone",
              "value": 9,
              "series": "Model B"
            },
            {
              "axis": "Coding",
              "value": 7,
              "series": "Model B"
            }
          ]
        }
      }
    }
  ]
}
