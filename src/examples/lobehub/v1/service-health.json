{
  "name": "Service Health",
  "description": "A status report: the verdict in a heading row with a Tag, headline figures in Metrics, the trend as a line Chart, and the incident as a Callout. No buttons: the card is the answer.",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "service-health",
        "catalogId": "https://lobehub.com/a2ui/catalog/v1"
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "service-health",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": ["header", "figures", "latency", "incident"]
          },
          {
            "id": "header",
            "component": "Row",
            "children": ["icon", "title", "status"],
            "align": "center"
          },
          {
            "id": "icon",
            "component": "Icon",
            "name": "lucide:activity"
          },
          {
            "id": "title",
            "component": "Text",
            "text": "#### API health: degraded since 14:00",
            "weight": 1
          },
          {
            "id": "status",
            "component": "Tag",
            "text": "Degraded",
            "color": "warning"
          },
          {
            "id": "figures",
            "component": "Metrics",
            "items": {
              "@path": "/metrics"
            }
          },
          {
            "id": "latency",
            "component": "Chart",
            "type": "line",
            "title": "P95 latency by hour",
            "data": {
              "@path": "/latency"
            },
            "index": "hour",
            "categories": ["p95"],
            "unit": "s"
          },
          {
            "id": "incident",
            "component": "Callout",
            "level": "warning",
            "title": "Provider timeouts after the 14:00 deploy",
            "body": "Rollback is staged; the error rate is still 3x the baseline."
          }
        ]
      }
    },
    {
      "version": "1.0",
      "updateDataModel": {
        "surfaceId": "service-health",
        "path": "/",
        "value": {
          "metrics": [
            {
              "label": "Error rate",
              "value": "2.4%",
              "delta": "+1.6pt",
              "direction": "up",
              "tone": "bad"
            },
            {
              "label": "P95",
              "value": "1.8s",
              "delta": "+0.7s",
              "direction": "up",
              "tone": "bad"
            },
            {
              "label": "Requests",
              "value": "3,214",
              "delta": "+4%",
              "direction": "up",
              "tone": "neutral"
            }
          ],
          "latency": [
            {
              "hour": "12:00",
              "p95": 1.0
            },
            {
              "hour": "13:00",
              "p95": 1.1
            },
            {
              "hour": "14:00",
              "p95": 2.3
            },
            {
              "hour": "15:00",
              "p95": 2.0
            },
            {
              "hour": "16:00",
              "p95": 1.8
            }
          ]
        }
      }
    }
  ]
}
