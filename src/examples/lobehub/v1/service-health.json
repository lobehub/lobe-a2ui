{
  "name": "Service Health",
  "description": "A status report: a Heading with a Badge, a StatGroup of the headline figures, a LineChart of the trend and an Alert for the incident.",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "service-health",
        "catalogId": "https://lobehub.com/a2ui/catalog/v1"
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "service-health",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": ["top", "figures", "latency", "incident"]
          },
          {
            "id": "top",
            "component": "Row",
            "align": "center",
            "justify": "spaceBetween",
            "children": ["head", "state"]
          },
          {
            "id": "head",
            "component": "Heading",
            "text": "API health",
            "eyebrow": "Degraded since 14:00"
          },
          {
            "id": "state",
            "component": "Badge",
            "label": "Degraded",
            "color": "warning"
          },
          {
            "id": "figures",
            "component": "StatGroup",
            "items": [
              {
                "label": "Error rate",
                "value": "2.4%",
                "delta": "+1.6 pts",
                "trend": "up"
              },
              {
                "label": "P95 latency",
                "value": "1.8s",
                "delta": "+0.7s",
                "trend": "up"
              },
              {
                "label": "Requests",
                "value": "3,214",
                "delta": "+4%",
                "trend": "flat"
              }
            ]
          },
          {
            "id": "latency",
            "component": "LineChart",
            "title": "P95 latency by hour",
            "subtitle": "Up 2.3x after the 14:00 deploy",
            "unit": "s",
            "data": {
              "@path": "/latency"
            }
          },
          {
            "id": "incident",
            "component": "Alert",
            "tone": "warning",
            "title": "Provider timeouts after the 14:00 deploy",
            "message": "Rollback is staged; the error rate is still 3x the baseline."
          }
        ]
      }
    },
    {
      "version": "1.0",
      "updateDataModel": {
        "surfaceId": "service-health",
        "path": "/",
        "value": {
          "latency": [
            {
              "x": "11:00",
              "y": 1.0
            },
            {
              "x": "12:00",
              "y": 1.0
            },
            {
              "x": "13:00",
              "y": 1.1
            },
            {
              "x": "14:00",
              "y": 2.3
            },
            {
              "x": "15:00",
              "y": 2.0
            },
            {
              "x": "16:00",
              "y": 1.8
            }
          ]
        }
      }
    }
  ]
}
