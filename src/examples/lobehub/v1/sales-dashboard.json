{
  "name": "Sales Dashboard",
  "description": "A dashboard: a Heading whose subtitle states the takeaway, a Grid of Stat, one BarChart and a DataTable with badge and currency columns, closed by an illustrative-data Caption.",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "sales-dashboard",
        "catalogId": "https://lobehub.com/a2ui/catalog/v1"
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "sales-dashboard",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": ["head", "kpis", "chart", "accounts", "note"]
          },
          {
            "id": "head",
            "component": "Heading",
            "text": "Q3 sales by region",
            "eyebrow": "Sales dashboard",
            "subtitle": "Revenue grew 11% on EMEA renewals"
          },
          {
            "id": "kpis",
            "component": "Grid",
            "columns": 3,
            "children": ["k1", "k2", "k3"]
          },
          {
            "id": "k1",
            "component": "Stat",
            "label": "Revenue",
            "value": "$18.4M",
            "delta": "+11.2%",
            "trend": "up",
            "caption": "vs Q2"
          },
          {
            "id": "k2",
            "component": "Stat",
            "label": "Units sold",
            "value": "128k",
            "delta": "+8.4%",
            "trend": "up",
            "caption": "vs Q2"
          },
          {
            "id": "k3",
            "component": "Stat",
            "label": "Quota attainment",
            "value": "104%",
            "delta": "+3 pts",
            "trend": "up",
            "caption": "Team of 42"
          },
          {
            "id": "chart",
            "component": "BarChart",
            "title": "Revenue by region",
            "subtitle": "EMEA closed the gap on North America",
            "format": "currency",
            "data": {
              "@path": "/regions"
            }
          },
          {
            "id": "accounts",
            "component": "DataTable",
            "title": "Top accounts",
            "columns": [
              {
                "key": "account",
                "label": "Account"
              },
              {
                "key": "plan",
                "label": "Plan",
                "format": "badge"
              },
              {
                "key": "status",
                "label": "Status",
                "format": "badge"
              },
              {
                "key": "mrr",
                "label": "MRR",
                "format": "currency",
                "align": "right"
              },
              {
                "key": "growth",
                "label": "Growth",
                "format": "percent",
                "align": "right"
              }
            ],
            "rows": {
              "@path": "/accounts"
            },
            "pageSize": 5
          },
          {
            "id": "note",
            "component": "Caption",
            "text": "Illustrative data"
          }
        ]
      }
    },
    {
      "version": "1.0",
      "updateDataModel": {
        "surfaceId": "sales-dashboard",
        "path": "/",
        "value": {
          "regions": [
